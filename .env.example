# FruitLab R3 环境变量示例。复制为 .env 并填写；.env 不入 git。
# classroom（本地课堂）示例；production 见 docs/deploy.md。

# --- 数据库身份（同一组变量生成 DSN、pg_isready、备份参数） ---
POSTGRES_USER=fruitlab
POSTGRES_DB=fruitlab
POSTGRES_PASSWORD=change-me-postgres

# --- 应用 ---
APP_ENV=development
PUBLIC_URL=http://127.0.0.1:4175
TRUST_PROXY=1
SESSION_TTL_SECONDS=86400
COOKIE_SECURE=0

# classroom 演示口令（禁止用于公网）
DEMO_PASSWORD=demo1234

# production 必填：>=12 字符、非默认、与 DEMO_PASSWORD 不同
ADMIN_PASSWORD=change-me-admin-password
